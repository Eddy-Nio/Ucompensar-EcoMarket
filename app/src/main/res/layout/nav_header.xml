<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_header"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_m"
    android:paddingTop="@dimen/space_xl"
    android:paddingEnd="@dimen/space_m"
    android:paddingBottom="@dimen/space_l">

    <TextView
        android:id="@+id/txtInitial"
        android:layout_width="@dimen/avatar_size"
        android:layout_height="@dimen/avatar_size"
        android:background="@drawable/bg_avatar"
        android:contentDescription="@string/cd_avatar"
        android:gravity="center"
        android:textAppearance="@style/Text.Subtitle"
        android:textColor="@color/eco_green_dark" />

    <TextView
        android:id="@+id/txtUserName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:textAppearance="@style/Text.Subtitle"
        android:textColor="@color/eco_white" />

    <TextView
        android:id="@+id/txtUserRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Text.Caption"
        android:textColor="@color/eco_green_light" />
</LinearLayout>
