<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/eco_green"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/eco_white"
        app:title="@string/payment_title"
        app:titleTextColor="@color/eco_white" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/eco_orange" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Checkout web de ePayco -->
        <WebView
            android:id="@+id/webCheckout"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Se muestra mientras se valida la transacción con ePayco -->
        <LinearLayout
            android:id="@+id/panelValidating"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/eco_gray_light"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_l"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/eco_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:text="@string/payment_validating"
                android:textAppearance="@style/Text.Subtitle" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
