<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
   
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_l">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:contentDescription="@string/cd_logo"
        android:src="@drawable/ic_launcher" />

    <TextView
        android:id="@+id/txtAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/app_name"
        android:textAppearance="@style/Text.Display"
        android:textColor="@color/eco_white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        android:text="@string/slogan"
        android:textAppearance="@style/Text.Body"
        android:textColor="@color/eco_green_light" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:indeterminate="true"
        app:indicatorColor="@color/eco_orange" />
</LinearLayout>
