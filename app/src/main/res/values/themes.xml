<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EcoMarket" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/eco_green</item>
        <item name="colorOnPrimary">@color/eco_white</item>
        <item name="colorPrimaryContainer">@color/eco_green_light</item>
        <item name="colorOnPrimaryContainer">@color/eco_green_dark</item>
        <item name="colorSecondary">@color/eco_orange</item>
        <item name="colorOnSecondary">@color/eco_white</item>
        <item name="colorSecondaryContainer">@color/eco_green_surface</item>
        <item name="colorOnSecondaryContainer">@color/eco_green_dark</item>
        <item name="colorSurface">@color/eco_background</item>
        <item name="colorOnSurface">@color/eco_text_primary</item>
        <item name="colorOutline">@color/eco_gray_border</item>
        <item name="colorError">@color/eco_error</item>
        <item name="android:colorBackground">@color/eco_gray_light</item>
        <item name="android:statusBarColor">@color/eco_green_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/eco_text_primary</item>
        <item name="android:textColorSecondary">@color/eco_text_secondary</item>
    </style>

    <style name="Theme.EcoMarket.Splash">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/eco_green_dark</item>
        <item name="android:navigationBarColor">@color/eco_green_dark</item>
    </style>
</resources>
