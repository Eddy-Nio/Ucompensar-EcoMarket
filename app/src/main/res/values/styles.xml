<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tipografía: Roboto (Título 20sp Bold, Subtítulo 16sp Medium, Texto 14sp Regular) -->
    <style name="Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/eco_text_primary</item>
    </style>
    <style name="Text.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/eco_text_primary</item>
    </style>
    <style name="Text.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/eco_text_primary</item>
    </style>
    <style name="Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/eco_text_primary</item>
    </style>
    <style name="Text.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/eco_text_secondary</item>
    </style>
    <style name="Text.Price" parent="Text.Subtitle">
        <item name="android:textColor">@color/eco_green</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Botones -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/eco_green</item>
        <item name="android:textColor">@color/eco_white</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Button.Accent" parent="Button.Primary">
        <item name="backgroundTint">@color/eco_orange</item>
        <item name="android:textColor">@color/eco_text_primary</item>
    </style>
    <style name="Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/eco_green</item>
        <item name="android:textColor">@color/eco_green</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/eco_error</item>
        <item name="android:textColor">@color/eco_error</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_button</item>
    </style>
    <style name="Button.Small" parent="Button.Accent">
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Tarjetas, campos y chips -->
    <style name="Card.Eco" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/eco_white</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="android:layout_margin">@dimen/space_s</item>
    </style>
    <style name="Input.Eco" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/eco_green</item>
        <item name="hintTextColor">@color/eco_green</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="android:layout_marginTop">@dimen/space_s</item>
    </style>
    <style name="Chip.Eco" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="android:textColor">@color/eco_text_primary</item>
        <item name="chipStrokeColor">@color/eco_gray_border</item>
        <item name="checkedIconTint">@color/eco_green</item>
    </style>
    <style name="Section.Header" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_m</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
        <item name="android:textAppearance">@style/Text.Subtitle</item>
    </style>
</resources>
