<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo en compilaciones de depuración: permite HTTP sin TLS para hablar con el Firebase
  Emulator Suite, ya sea desde el emulador de Android (10.0.2.2) o desde un teléfono físico
  conectado por Wi-Fi a la IP del computador. La versión release no incluye este archivo,
  así que en producción todo el tráfico va por HTTPS (RNF-03).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
